begin main()
x := 1 + (2 + 3)
-> true(x)
x := 2 + (5 + 7)
-> false(x) // does not get executed, so no error occurs later!
true(y)false <- y > 4
res := y + (1 + 0)
end main(res)

/* Output with option --print-main should look like this:

    Variables at end of 'Forward.main' subroutine:
    res = 7

*/
