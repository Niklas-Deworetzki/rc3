/* ORIGINAL JANUS CODE
procedure main()
    int n
    int x1
    int x2
    x1 += 5
    x2 += 8
    uncall fib(n, x1, x2)

procedure fib(int n, int x1, int x2)
  if n=0 then x1 += 1
              x2 += 1
         else n -= 1
              call fib(n, x1, x2)
              x1 += x2
              x1 ^= x2
              x2 ^= x1
              x1 ^= x2
  fi x1=x2
*/


