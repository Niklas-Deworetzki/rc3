#! /bin/sh

VERSION=$( cd compiler ; mvn org.apache.maven.plugins:maven-help-plugin:3.1.0:evaluate -Dexpression=project.version -q -DforceStdout )
rssa_jar=./compiler/target/rssa-vm-$VERSION.jar

if [ ! -f $rssa_jar ]; then
  echo "Executable JAR is not present. Building it.."
  ( cd compiler ; mvn --quiet package -P rssa-vm )
fi

java -jar $rssa_jar $@
